{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kmust-schedule-sync",
  "main": "src/index.mjs",
  "compatibility_date": "2026-08-30",
  "workers_dev": true,
  "preview_urls": false,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "vars": {
    "ALLOWED_ORIGIN": "https://kaneshiroakatsuki.github.io"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yuheng-institute-db",
      "database_id": "e2aa06c8-4a2f-4b76-b238-85671dcdb751"
    }
  ],
  "observability": {
    "enabled": true
  }
}
